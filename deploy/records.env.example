# Match each instance ID, public TLS address and key to its room configuration.
# Separate multiple entries with semicolons.
SURF_ROOM_TICKETS=boreas-eu|tls://room.example.com:27165|REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SURF_RECORDS_TRUST_REAL_IP=1

# Comma-separated native records account IDs for moderators.
# SURF_ROOM_MODERATOR_IDS=1,2

# Enable Google or X sign-in using credentials for this records origin.
# SURF_OAUTH_PUBLIC_URL=https://records.example.com
# SURF_GOOGLE_CLIENT_ID=
# SURF_GOOGLE_CLIENT_SECRET=
# SURF_X_CLIENT_ID=
# SURF_X_CLIENT_SECRET=
